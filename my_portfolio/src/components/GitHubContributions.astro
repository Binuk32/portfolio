---
const username = 'Binuk32';
---

<section id="contributions" class="relative z-10 max-w-7xl mx-auto w-full px-3.5 sm:px-6 py-12 md:py-24 border-t border-zinc-900/80">
    <div class="max-w-3xl mb-8 md:mb-12">
        <div class="flex items-center gap-2 px-3 py-1 bg-zinc-900/80 border border-zinc-800 rounded-full mb-3 sm:mb-4 w-fit">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="text-[10px] sm:text-xs font-semibold text-zinc-400 tracking-wider uppercase font-mono">Open Source Activity</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-white leading-tight">
            GitHub Contributions
        </h2>
        <p class="mt-2.5 sm:mt-4 text-zinc-400 text-xs sm:text-base md:text-lg font-light leading-relaxed">
            A live look at my coding activity over the past year.
        </p>
    </div>

    <div class="relative rounded-2xl border border-zinc-800/80 bg-zinc-900/30 backdrop-blur-xl p-4 sm:p-6 md:p-8 shadow-lg">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
            <p id="contribution-total" class="text-sm text-zinc-300" aria-live="polite">Loading contributions…</p>
            <a
                href={`https://github.com/${username}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors"
            >
                View GitHub profile ↗
            </a>
        </div>

        <div class="calendar-scroll overflow-x-auto pb-2" tabindex="0" aria-label="Scrollable GitHub contribution calendar">
            <div class="calendar-layout">
                <div class="month-labels" aria-hidden="true"></div>
                <div class="weekday-labels" aria-hidden="true">
                    <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
                </div>
                <div id="contribution-grid" class="contribution-grid" aria-label="Daily GitHub contributions for the last year"></div>
            </div>
        </div>
        <p class="mt-2 text-[10px] text-zinc-500 font-mono sm:hidden">Swipe to explore the full year →</p>

        <div class="flex items-center justify-end gap-1.5 mt-4 text-[10px] text-zinc-500 font-mono">
            <span>Less</span>
            <span class="day-cell" data-level="0" aria-hidden="true"></span>
            <span class="day-cell" data-level="1" aria-hidden="true"></span>
            <span class="day-cell" data-level="2" aria-hidden="true"></span>
            <span class="day-cell" data-level="3" aria-hidden="true"></span>
            <span class="day-cell" data-level="4" aria-hidden="true"></span>
            <span>More</span>
        </div>
    </div>
</section>

<script>
    const username = 'Binuk32';
    const grid = document.querySelector('#contribution-grid');
    const total = document.querySelector('#contribution-total');

    if (grid instanceof HTMLElement && total instanceof HTMLElement) {
        const dateFormatter = new Intl.DateTimeFormat(undefined, {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC'
        });

        try {
            const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(username)}?y=last`);
            if (!response.ok) throw new Error(`Contribution service returned ${response.status}`);

            const data = await response.json();
            if (!Array.isArray(data.contributions) || typeof data.total?.lastYear !== 'number') {
                throw new Error('Contribution service returned unexpected data');
            }

            const firstDate = new Date(`${data.contributions[0]?.date}T00:00:00Z`);
            const offset = Number.isNaN(firstDate.getTime()) ? 0 : (firstDate.getUTCDay() + 6) % 7;
            for (let index = 0; index < offset; index += 1) {
                const spacer = document.createElement('span');
                spacer.setAttribute('aria-hidden', 'true');
                grid.append(spacer);
            }

            const monthLabels = document.querySelector('.month-labels');
            const seenMonths = new Set();
            let previousMonthWeek = -1;

            for (const [index, contribution] of data.contributions.entries()) {
                if (typeof contribution.date !== 'string' || typeof contribution.count !== 'number') continue;

                const date = new Date(`${contribution.date}T00:00:00Z`);
                if (Number.isNaN(date.getTime())) continue;
                const weekIndex = Math.floor((index + offset) / 7);
                const monthKey = `${date.getUTCFullYear()}-${date.getUTCMonth()}`;

                if (monthLabels instanceof HTMLElement && !seenMonths.has(monthKey)) {
                    const month = document.createElement('span');
                    month.className = 'month-label';
                    month.textContent = new Intl.DateTimeFormat(undefined, { month: 'short', timeZone: 'UTC' }).format(date);
                    month.style.left = `calc(${Math.max(weekIndex, previousMonthWeek + 1)} * var(--week-width))`;
                    monthLabels.append(month);
                    seenMonths.add(monthKey);
                    previousMonthWeek = Math.max(weekIndex, previousMonthWeek + 1);
                }

                const day = document.createElement('span');
                const level = Number.isInteger(contribution.level) ? Math.min(4, Math.max(0, contribution.level)) : 0;
                day.className = 'day-cell';
                day.dataset.level = String(level);
                day.title = `${contribution.count} contributions on ${dateFormatter.format(date)}`;
                day.setAttribute('aria-label', day.title);
                day.setAttribute('role', 'img');
                grid.append(day);
            }

            total.textContent = `${data.total.lastYear.toLocaleString()} contributions in the last year`;
        } catch (error) {
            console.error('Unable to load GitHub contributions:', error);
            total.textContent = 'Contributions are temporarily unavailable. View my activity on GitHub instead.';
        }
    }
</script>

<style is:global>
    .calendar-layout {
        display: grid;
        grid-template-columns: 2rem max-content;
        gap: 0.5rem;
        width: max-content;
        min-width: 100%;
    }

    .month-labels {
        --week-width: 0.95rem;
        position: relative;
        grid-column: 2;
        height: 0.75rem;
        width: max-content;
        color: #71717a;
        font: 0.625rem/1 ui-monospace, monospace;
    }

    .month-label {
        position: absolute;
        white-space: nowrap;
    }

    .weekday-labels,
    .contribution-grid {
        display: grid;
        grid-template-rows: repeat(7, 0.7rem);
        grid-auto-flow: column;
        gap: 0.25rem;
    }

    .weekday-labels {
        grid-auto-columns: 2rem;
        align-items: center;
        color: #71717a;
        font: 0.625rem/1 ui-monospace, monospace;
    }

    .contribution-grid {
        grid-auto-columns: 0.7rem;
        grid-row: 2;
    }

    .weekday-labels {
        grid-row: 2;
    }

    .day-cell {
        display: block;
        width: 0.7rem;
        height: 0.7rem;
        border: 1px solid rgb(63 63 70 / 45%);
        border-radius: 2px;
        background: #18181b;
    }

    .day-cell[data-level='1'] { background: #164e63; border-color: #155e75; }
    .day-cell[data-level='2'] { background: #0e7490; border-color: #0891b2; }
    .day-cell[data-level='3'] { background: #06b6d4; border-color: #22d3ee; }
    .day-cell[data-level='4'] { background: #67e8f9; border-color: #a5f3fc; }

    @media (max-width: 640px) {
        .calendar-layout {
            grid-template-columns: 1.5rem max-content;
            gap: 0.3rem;
        }

        .month-labels {
            --week-width: 0.73rem;
            height: 0.7rem;
            font-size: 0.55rem;
        }

        .weekday-labels {
            grid-template-rows: repeat(7, 0.55rem);
            grid-auto-columns: 1.5rem;
            font-size: 0.55rem;
        }

        .contribution-grid {
            grid-template-rows: repeat(7, 0.55rem);
            grid-auto-columns: 0.55rem;
            gap: 0.18rem;
        }

        .day-cell {
            width: 0.55rem;
            height: 0.55rem;
        }

        .calendar-scroll {
            overscroll-behavior-x: contain;
            scrollbar-width: thin;
            scrollbar-color: #3f3f46 transparent;
        }
    }
</style>
