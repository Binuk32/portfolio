---
// src/components/Experience.astro
import { Image } from 'astro:assets';
import localCssIcon from '../assets/css-3.png';
import localJavaIcon from '../assets/java.png';
import localSqlIcon from '../assets/sql-server.png';

const skillCategories = [
    {
        title: "Frontend Development",
        description: "Building responsive, modern, and interactive user interfaces.",
        skills: [
            { name: "HTML5", icon: "html5", color: "E34F26", isLocal: false },
            { name: "CSS3", icon: localCssIcon, color: "", isLocal: true },
            { name: "JavaScript", icon: "javascript", color: "F7DF1E", isLocal: false },
            { name: "TypeScript", icon: "typescript", color: "3178C6", isLocal: false },
            { name: "React", icon: "react", color: "61DAFB", isLocal: false },
            { name: "Tailwind CSS", icon: "tailwindcss", color: "06B6D4", isLocal: false },
            { name: "Astro", icon: "astro", color: "FF5D01", isLocal: false }
        ]
    },
    {
        title: "Backend Architecture",
        description: "Developing robust, secure, and scalable server-side systems.",
        skills: [
            { name: "Java", icon: localJavaIcon, color: "437291", isLocal: true },
            { name: "Spring Boot", icon: "springboot", color: "6DB33F", isLocal: false },
            { name: "Tomcat", icon: "apachetomcat", color: "F8DC75", isLocal: false },
            { name: "Node.js", icon: "nodedotjs", color: "5FA41C", isLocal: false },
            { name: "Express.js", icon: "express", color: "FFFFFF", isLocal: false },
            { name: "Hono", icon: "hono", color: "E36049", isLocal: false }
        ]
    },
    {
        title: "Database & Core Tools",
        description: "Managing structured data pipelines and version control systems.",
        skills: [
            { name: "MySQL", icon: "mysql", color: "4479A1", isLocal: false },
            { name: "Microsoft SQL", icon: localSqlIcon, color: "CC292B", isLocal: true },
            { name: "MongoDB", icon: "mongodb", color: "47A248", isLocal: false },
            { name: "Git", icon: "git", color: "F05032", isLocal: false },
            { name: "GitHub", icon: "github", color: "FFFFFF", isLocal: false },
            { name: "Postman", icon: "postman", color: "FF6C37", isLocal: false }
        ]
    },
    {
        title: "Cloud & Deployments",
        description: "Configuring continuous integration and hosting applications production-ready.",
        skills: [
            { name: "Vercel", icon: "vercel", color: "FFFFFF", isLocal: false },
            { name: "Render", icon: "render", color: "46E3B7", isLocal: false },
            { name: "Railway", icon: "railway", color: "F343DA", isLocal: false },
            { name: "Netlify", icon: "netlify", color: "00C7B7", isLocal: false }
        ]
    }
];
---

<section id="experience" class="reveal-section opacity-0 translate-y-8 transition-all duration-1000 ease-out relative z-10 max-w-7xl mx-auto w-full px-3.5 sm:px-6 py-12 md:py-32 border-t border-zinc-900/80">

    <!-- Ambient Glow Effect -->
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[250px] sm:w-[300px] md:w-[500px] h-[250px] sm:h-[300px] md:h-[500px] bg-cyan-500/5 rounded-full blur-[100px] md:blur-[180px] pointer-events-none"></div>

    <!-- Header Block -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left mb-8 md:mb-20 max-w-3xl">
        <div class="flex items-center gap-2 px-3 py-1 bg-zinc-900/80 border border-zinc-800 rounded-full mb-3 sm:mb-4">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="text-[10px] sm:text-xs font-semibold text-zinc-400 tracking-wider uppercase font-mono">My Stack & Expertise</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-white leading-tight">
            Technical Skills
        </h2>
        <p class="mt-2.5 sm:mt-4 text-zinc-400 text-xs sm:text-base md:text-xl font-light leading-relaxed">
            A comprehensive overview of the frameworks, languages, databases, and continuous delivery tools I leverage to build modern full-stack web applications.
        </p>
    </div>

    <!-- Skill Categories Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 md:gap-12">
        {skillCategories.map((category) => (
                <div class="relative group rounded-2xl md:rounded-[2rem] border border-cyan-950/40 bg-[#0a1120]/90 md:bg-[#0a1120]/40 md:backdrop-blur-xl p-4 sm:p-8 md:p-12 transition-all duration-300 hover:border-cyan-500/30 hover:bg-[#0f1b35]/80 shadow-md overflow-hidden">

                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-cyan-500/10 to-transparent rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                    <div>
                        <h3 class="text-lg sm:text-2xl md:text-3xl font-extrabold text-white mb-1.5 sm:mb-3 flex items-center gap-2.5 sm:gap-3 tracking-tight">
                            <span class="w-1.5 md:w-2 h-5 sm:h-6 md:h-8 bg-gradient-to-b from-cyan-400 to-blue-600 rounded-full shadow-[0_0_15px_rgba(34,211,238,0.4)]"></span>
                            {category.title}
                        </h3>
                        <p class="text-zinc-400 text-xs sm:text-sm md:text-base font-light mb-4 sm:mb-6 md:mb-10 max-w-xl leading-relaxed">
                            {category.description}
                        </p>

                        <!-- Skill Badges Container -->
                        <div class="flex flex-wrap gap-2 sm:gap-3 md:gap-4">
                            {category.skills.map((skill) => (
                                    <div class="flex items-center gap-2 sm:gap-3 px-2.5 sm:px-4 md:px-5 py-1.5 sm:py-2.5 md:py-3 bg-slate-900/60 sm:bg-slate-900/40 border border-slate-800/80 rounded-lg sm:rounded-xl md:rounded-2xl hover:bg-slate-900/90 hover:border-cyan-500/40 transition-all duration-200 transform sm:hover:-translate-y-0.5 group/badge cursor-default select-none">

                                        {skill.isLocal ? (
                                                <Image
                                                        src={skill.icon as any}
                                                        alt={`${skill.name} icon`}
                                                        class="w-4 h-4 sm:w-5 sm:h-5 md:w-7 md:h-7 object-contain group-hover/badge:scale-110 transition-transform duration-300"
                                                />
                                        ) : (
                                                <img
                                                        src={`https://cdn.simpleicons.org/${skill.icon}/${skill.color}`}
                                                        alt={`${skill.name} icon`}
                                                        class="w-4 h-4 sm:w-5 sm:h-5 md:w-7 md:h-7 object-contain filter brightness-100 group-hover/badge:scale-110 transition-transform duration-300"
                                                        loading="lazy"
                                                />
                                        )}

                                        <span class="text-xs sm:text-sm md:text-base font-bold text-zinc-200 group-hover/badge:text-white transition-colors duration-200">
                                            {skill.name}
                                        </span>
                                    </div>
                            ))}
                        </div>
                    </div>
                </div>
        ))}
    </div>
</section>

<script>
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.05
    };

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-8');
                entry.target.classList.add('opacity-100', 'translate-y-0');
                revealObserver.unobserve(entry.target);
            }
        });
    }, observerOptions);

    const target = document.querySelector('.reveal-section');
    if (target) {
        revealObserver.observe(target);
    }
</script>