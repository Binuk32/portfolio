---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 w-full border-t border-zinc-800/60 bg-[#070d19]/80 backdrop-blur-md py-4 sm:py-5 px-4 sm:px-8">

    <!-- Top Subtle Highlight Bar -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/3 sm:w-1/4 h-[1px] bg-gradient-to-r from-transparent via-cyan-500/40 to-transparent"></div>

    <!-- Ambient Glow -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[200px] sm:w-[350px] h-[40px] bg-cyan-500/5 rounded-full blur-[70px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto flex flex-col items-center justify-center text-center">

        <!-- Mobile: 2 Stacked Lines | Desktop: 1 Single Line -->
        <div class="flex flex-col sm:flex-row items-center gap-1 sm:gap-2">
            <p class="text-xs sm:text-sm font-medium text-zinc-300">
                Designed & Built by <span class="text-cyan-400 font-semibold hover:text-cyan-300 transition-colors">Binuk Pinsara</span>
            </p>

            <!-- Separator dot (hidden on mobile, visible on desktop) -->
            <span class="hidden sm:inline text-zinc-600 text-xs">•</span>

            <p class="text-[10px] sm:text-xs text-zinc-500 font-mono">
                © {currentYear} All rights reserved.
            </p>
        </div>

    </div>
</footer>