---
// src/components/Education.astro
import { Image } from 'astro:assets';
import sliitLogo from '../assets/sliitLogo.png';
import ruhunuVijayabaLogo from '../assets/ruhunuVijayabaLogo.jpg';

const educationData = [
    {
        institution: "Sri Lanka Institute of Information Technology (SLIIT)",
        degree: "BSc. (Hons) in Information Technology specializing in Software Engineering",
        status: "3rd Year Undergraduate Student",
        period: "Mar 2024 - Present",
        logo: sliitLogo,
        details: [
            "Deepening knowledge in advanced software architecture, cloud platforms, and full-stack enterprise systems.",
            "Maintaining strong practical execution across modern engineering stacks."
        ]
    },
    {
        institution: "H/Ruhunu Vijayaba National College",
        degree: "G.C.E. Advanced Level (Physical Science Stream)",
        status: "Mathematics Stream — B (Combined Maths), C (Chemistry), S (Physics)",
        period: "Mar 2021 - Jan 2024",
        logo: ruhunuVijayabaLogo,
        details: [
            "Developed core mathematical, problem-solving, and analytical foundations critical for computer science.",
            "Graduated with verified high academic standing."
        ]
    },
    {
        institution: "H/Ruhunu Vijayaba National College",
        degree: "G.C.E. Ordinary Level",
        status: "Passed with 6 A's (including Mathematics and Science), 1 B, 2 C's",
        period: "Jan 2015 - Mar 2021",
        logo: ruhunuVijayabaLogo,
        details: [
            "Exhibited early excellence across core science and computational logic tracks.",
            "Active participant in extracurricular science and math circles."
        ]
    }
];
---

<section id="education" class="reveal-education opacity-0 translate-y-8 transition-all duration-1000 ease-out relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 py-16 md:py-32 border-t border-zinc-900/80">

    <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-[300px] md:w-[500px] h-[300px] md:h-[500px] bg-blue-500/5 rounded-full blur-[120px] md:blur-[180px] pointer-events-none"></div>

    <div class="flex flex-col items-center md:items-start text-center md:text-left mb-16 md:mb-24 max-w-3xl">
        <div class="flex items-center gap-2 px-3 py-1 bg-zinc-900/80 border border-zinc-800 rounded-full mb-4">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="text-xs font-semibold text-zinc-400 tracking-wider uppercase">Academic Journey</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-white leading-tight">
            Education
        </h2>
        <p class="mt-4 text-zinc-400 text-base md:text-xl font-light leading-relaxed">
            My formal academic timeline, milestones, and technical foundations built throughout my educational path.
        </p>
    </div>

    <div class="relative max-w-5xl mx-auto pl-2 sm:pl-8">

        <div class="absolute left-2.5 sm:left-8 top-2 bottom-2 w-[2px] bg-gradient-to-b from-cyan-500/50 via-blue-600/30 to-zinc-900"></div>

        <div class="space-y-10 md:space-y-16">
            {educationData.map((item) => (
                    <div class="relative pl-7 sm:pl-14 group">

                        <div class="absolute left-[5px] sm:left-[27px] top-7 sm:top-9 w-3 h-3 rounded-full bg-zinc-950 border-2 border-cyan-400 z-20 group-hover:scale-125 group-hover:bg-cyan-400 shadow-[0_0_10px_rgba(34,211,238,0.5)] transition-all duration-300"></div>

                        <div class="relative rounded-[1.5rem] md:rounded-[2rem] border border-cyan-950/40 bg-[#0a1120]/40 backdrop-blur-xl p-5 sm:p-8 md:p-10 transition-all duration-500 hover:border-cyan-500/30 hover:bg-[#0f1b35]/60 shadow-[0_0_50px_-12px_rgba(6,182,212,0.05)] hover:shadow-[0_0_50px_-6px_rgba(6,182,212,0.15)] flex flex-col md:flex-row items-start md:items-center justify-between gap-6 overflow-hidden">

                            <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-cyan-500/5 to-transparent rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                            <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-6 flex-1">
                                <div class="w-12 h-12 sm:w-16 sm:h-16 shrink-0 rounded-xl sm:rounded-2xl overflow-hidden border border-zinc-800/80 bg-white p-1 shadow-md">
                                    <Image
                                            src={item.logo}
                                            alt={`${item.institution} logo`}
                                            class="w-full h-full object-contain"
                                    />
                                </div>

                                <div class="space-y-2 w-full">
                                    <span class="text-[10px] sm:text-xs font-semibold px-2.5 py-1 bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 rounded-md inline-block uppercase tracking-wider">
                                        {item.period}
                                    </span>
                                    <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight leading-snug pt-1">
                                        {item.institution}
                                    </h3>
                                    <h4 class="text-base sm:text-lg font-bold text-cyan-300/90">
                                        {item.degree}
                                    </h4>
                                    <p class="text-xs sm:text-sm font-semibold text-zinc-400 italic">
                                        {item.status}
                                    </p>

                                    <ul class="mt-4 space-y-2 text-zinc-400/80 text-xs sm:text-sm font-light list-disc pl-4 max-w-2xl">
                                        {item.details.map((detail) => (
                                                <li>{detail}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>
            ))}
        </div>
    </div>
</section>

<script>
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-8');
                entry.target.classList.add('opacity-100', 'translate-y-0');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.05 }); // Lower threshold allows smoother entry on mobile screens

    const target = document.querySelector('.reveal-education');
    if (target) revealObserver.observe(target);
</script>