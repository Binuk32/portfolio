---
// src/components/Education.astro
import { Image } from 'astro:assets';
import sliitLogo from '../assets/sliitLogo.png';
import ruhunuVijayabaLogo from '../assets/ruhunuVijayabaLogo.jpg';

const educationData = [
    {
        institution: "Sri Lanka Institute of Information Technology (SLIIT)",
        degree: "BSc. (Hons) in Information Technology specializing in Software Engineering",
        status: "3rd Year Undergraduate Student",
        period: "Mar 2024 - Present",
        logo: sliitLogo,
        details: [
            "Deepening knowledge in advanced software architecture, cloud platforms, and full-stack enterprise systems.",
            "Maintaining strong practical execution across modern engineering stacks."
        ]
    },
    {
        institution: "H/Ruhunu Vijayaba National College",
        degree: "G.C.E. Advanced Level (Physical Science Stream)",
        status: "Mathematics Stream — B (Combined Maths), C (Chemistry), S (Physics)",
        period: "Mar 2021 - Jan 2024",
        logo: ruhunuVijayabaLogo,
        details: [
            "Developed core mathematical, problem-solving, and analytical foundations critical for computer science.",
            "Graduated with verified high academic standing."
        ]
    },
    {
        institution: "H/Ruhunu Vijayaba National College",
        degree: "G.C.E. Ordinary Level",
        status: "Passed with 6 A's (including Mathematics and Science), 1 B, 2 C's",
        period: "Jan 2015 - Mar 2021",
        logo: ruhunuVijayabaLogo,
        details: [
            "Exhibited early excellence across core science and computational logic tracks.",
            "Active participant in extracurricular science and math circles."
        ]
    }
];
---

<section id="education" class="reveal-education opacity-0 translate-y-8 transition-all duration-1000 ease-out relative z-10 max-w-7xl mx-auto w-full px-3.5 sm:px-6 py-12 md:py-32 border-t border-zinc-900/80">

    <!-- Ambient Background Glow -->
    <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-[250px] sm:w-[300px] md:w-[500px] h-[250px] sm:h-[300px] md:h-[500px] bg-blue-500/5 rounded-full blur-[100px] md:blur-[180px] pointer-events-none"></div>

    <!-- Section Header -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left mb-10 md:mb-24 max-w-3xl">
        <div class="flex items-center gap-2 px-3 py-1 bg-zinc-900/80 border border-zinc-800 rounded-full mb-3 sm:mb-4">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="text-[10px] sm:text-xs font-semibold text-zinc-400 tracking-wider uppercase">Academic Journey</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black tracking-tight text-white leading-tight">
            Education
        </h2>
        <p class="mt-2.5 sm:mt-4 text-zinc-400 text-xs sm:text-base md:text-xl font-light leading-relaxed">
            My formal academic timeline, milestones, and technical foundations built throughout my educational path.
        </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative max-w-5xl mx-auto pl-1 sm:pl-8">

        <!-- Vertical Timeline Line -->
        <div class="absolute left-1.5 sm:left-8 top-2 bottom-2 w-[2px] bg-gradient-to-b from-cyan-500/50 via-blue-600/30 to-zinc-900"></div>

        <div class="space-y-6 sm:space-y-10 md:space-y-16">
            {educationData.map((item) => (
                    <div class="relative pl-5 sm:pl-14 group">

                        <!-- Timeline Dot -->
                        <div class="absolute left-0 sm:left-[27px] top-6 sm:top-9 w-3 h-3 rounded-full bg-zinc-950 border-2 border-cyan-400 z-20 group-hover:scale-125 group-hover:bg-cyan-400 shadow-[0_0_10px_rgba(34,211,238,0.5)] transition-all duration-300"></div>

                        <!-- Card Body -->
                        <div class="relative rounded-xl sm:rounded-[1.5rem] md:rounded-[2rem] border border-cyan-950/40 bg-[#0a1120]/90 md:bg-[#0a1120]/40 md:backdrop-blur-xl p-4 sm:p-8 md:p-10 transition-all duration-300 hover:border-cyan-500/30 hover:bg-[#0f1b35]/80 shadow-lg overflow-hidden">

                            <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-cyan-500/5 to-transparent rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                            <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6 flex-1">

                                <!-- Mobile Header Row (Logo + Period Badge) -->
                                <div class="flex items-center justify-between sm:justify-start w-full sm:w-auto gap-3">
                                    <div class="w-10 h-10 sm:w-16 sm:h-16 shrink-0 rounded-lg sm:rounded-2xl overflow-hidden border border-zinc-800/80 bg-white p-1 shadow-md">
                                        <Image
                                                src={item.logo}
                                                alt={`${item.institution} logo`}
                                                class="w-full h-full object-contain"
                                        />
                                    </div>

                                    <!-- Period Badge for Mobile Screen -->
                                    <span class="sm:hidden text-[9px] font-mono font-semibold px-2 py-0.5 bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 rounded-md uppercase tracking-wider">
                                        {item.period}
                                    </span>
                                </div>

                                <!-- Text Details Block -->
                                <div class="space-y-1.5 sm:space-y-2 w-full">
                                    <!-- Period Badge for Desktop Screen -->
                                    <span class="hidden sm:inline-block text-xs font-semibold px-2.5 py-1 bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 rounded-md uppercase tracking-wider font-mono">
                                        {item.period}
                                    </span>

                                    <h3 class="text-base sm:text-2xl font-extrabold text-white tracking-tight leading-snug">
                                        {item.institution}
                                    </h3>
                                    <h4 class="text-xs sm:text-lg font-bold text-cyan-300/90 leading-tight">
                                        {item.degree}
                                    </h4>
                                    <p class="text-[11px] sm:text-sm font-medium text-zinc-400 italic">
                                        {item.status}
                                    </p>

                                    <!-- Bullet Details -->
                                    <ul class="mt-3 sm:mt-4 space-y-1.5 text-zinc-400/90 text-xs sm:text-sm font-light max-w-2xl">
                                        {item.details.map((detail) => (
                                                <li class="flex items-start gap-2">
                                                    <span class="text-cyan-400 font-bold text-[10px] sm:text-xs mt-0.5 select-none">✓</span>
                                                    <span class="leading-relaxed">{detail}</span>
                                                </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>
            ))}
        </div>
    </div>
</section>

<script>
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-8');
                entry.target.classList.add('opacity-100', 'translate-y-0');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.05 });

    const target = document.querySelector('.reveal-education');
    if (target) revealObserver.observe(target);
</script>