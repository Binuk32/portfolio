---

<section id="contact" class="reveal-contact opacity-0 translate-y-8 transition-all duration-1000 ease-out relative z-10 max-w-4xl mx-auto w-full px-3.5 sm:px-6 py-12 sm:py-20 md:py-32 border-t border-zinc-900/80 overflow-hidden">

    <!-- Ambient Glow Background -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250px] sm:w-[500px] h-[250px] sm:h-[500px] bg-cyan-500/5 rounded-full blur-[90px] sm:blur-[120px] pointer-events-none"></div>

    <div class="flex flex-col items-center text-center max-w-2xl mx-auto relative z-10">

        <!-- Intro Section -->
        <div class="flex items-center gap-2 px-3 py-1 bg-zinc-900/80 border border-zinc-800/80 rounded-full mb-4 sm:mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            <span class="text-[9px] sm:text-[10px] font-black text-cyan-400 tracking-widest uppercase font-mono">Available For Projects</span>
        </div>

        <h2 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-tight">
            Let's Build <span class="bg-gradient-to-r from-cyan-200 to-cyan-500 bg-clip-text text-transparent drop-shadow-[0_2px_15px_rgba(6,182,212,0.2)]">Something Next.</span>
        </h2>

        <p class="mt-3 sm:mt-4 text-zinc-400 text-xs sm:text-base md:text-lg font-light leading-relaxed mb-8 sm:mb-12 max-w-xl">
            Actively seeking opportunities to contribute to impactful software projects.
            From full-stack web and mobile applications to scalable backend systems, I'm available for freelance collaborations, internships, and full-time roles. Let's connect.
        </p>

        <!-- Channels Container -->
        <div class="w-full flex flex-col gap-3 sm:gap-4 max-w-xl">
            {contactLinks.map((link) => (
                    <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={`group relative w-full flex items-center justify-between p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-zinc-800/80 bg-[#040914]/90 md:bg-[#040914]/40 md:backdrop-blur-2xl transition-all duration-300 hover:border-cyan-500/30 active:scale-[0.98] ${link.glow} overflow-hidden select-none`}
                    >
                        <!-- Dynamic Backdrop Effect on Hover -->
                        <div class={`absolute inset-0 bg-gradient-to-r ${link.color} opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none`}></div>

                        <div class="flex items-center gap-3 sm:gap-4 relative z-10 min-w-0">
                            <!-- Neon Icon Frame -->
                            <div class="flex items-center justify-center shrink-0 w-9 h-9 sm:w-11 sm:h-11 rounded-lg sm:rounded-xl bg-zinc-950 border border-zinc-800 text-zinc-400 group-hover:text-cyan-400 group-hover:border-cyan-400/40 group-hover:bg-[#070e1b] transition-all duration-300 shadow-md">
                                <Fragment set:html={link.icon} />
                            </div>

                            <div class="flex flex-col text-left min-w-0">
                                <span class="text-[9px] font-mono font-black uppercase tracking-widest text-zinc-500 group-hover:text-cyan-400 transition-colors duration-300">
                                    {link.name}
                                </span>
                                <span class="text-xs sm:text-base font-bold text-zinc-300 group-hover:text-white transition-colors duration-300 truncate tracking-tight">
                                    {link.label}
                                </span>
                            </div>
                        </div>

                        <!-- Arrow Indicator -->
                        <div class="shrink-0 text-zinc-600 group-hover:text-cyan-400 transform opacity-80 group-hover:opacity-100 transition-all duration-300 ml-2">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:rotate-[-45deg]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </div>
                    </a>
            ))}
        </div>

    </div>
</section>

<script>
    const contactObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-8');
                entry.target.classList.add('opacity-100', 'translate-y-0');
                contactObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.05 });

    const contactTarget = document.querySelector('.reveal-contact');
    if (contactTarget) contactObserver.observe(contactTarget);
</script>