---
// src/components/Navbar.astro
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';

// Respect the site's base path (/portfolio)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Are we on the standalone /projects page?
const onProjectsPage = Astro.url.pathname.replace(/\/$/, '').endsWith('/projects');

// Section links point at the home page, so they work from any page.
// "Projects" goes to its own page.
const links = [
    { label: 'About',         href: `${base}/#about`,         section: 'about' },
    { label: 'Experience',    href: `${base}/#experience`,    section: 'experience' },
    { label: 'Education',     href: `${base}/#education`,     section: 'education' },
    { label: 'Projects',      href: `${base}/projects`,       section: 'projects' },
    { label: 'Contributions', href: `${base}/#contributions`, section: 'contributions' },
    { label: 'Contact',       href: `${base}/#contact`,       section: 'contact' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#050507]/80 backdrop-blur-md border-b border-zinc-800/50 transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4 md:gap-8">

        <div class="flex items-center justify-between w-full md:w-auto">
            <a href={`${base}/`} class="hover:opacity-80 transition-opacity flex items-center gap-3 group">
                <Image
                        src={myLogo}
                        alt="Binuk Pinsara Logo"
                        class="w-8 h-8 sm:w-10 sm:h-10 object-contain"
                />
                <span class="text-white text-base sm:text-lg font-semibold tracking-tight">
                    BinukPinsara
                </span>
            </a>
        </div>

        <nav class="flex items-center justify-center gap-5 sm:gap-6 md:gap-8 text-xs sm:text-sm font-medium text-zinc-400 overflow-x-auto max-w-full no-scrollbar py-1">
            {links.map((link) => (
                    <a
                            href={link.href}
                            data-section={link.section}
                            class:list={[
                                "nav-link relative py-1 hover:text-white transition-colors duration-150",
                                { active: onProjectsPage && link.section === 'projects' }
                            ]}
                            aria-current={onProjectsPage && link.section === 'projects' ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
            ))}
        </nav>

    </div>
</header>

<style>
    /* Hide scrollbar utility for the mobile navigation bar */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Smooth underline animation */
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: #06b6d4; /* Matches Tailwind cyan-500 */
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    /* Show underline on hover */
    .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* Active state classes (set on the server for /projects, by JS on the home page) */
    .nav-link.active {
        color: white;
    }

    .nav-link.active::after {
        transform: scaleX(1);
        transform-origin: left;
    }
</style>

<script>
    function setupScrollSpy() {
        const navLinks = document.querySelectorAll<HTMLElement>('.nav-link');

        // Only sections that exist on the current page are watched.
        // On /projects none of them exist, so this exits and the server-set active link stays.
        const sections = Array.from(navLinks)
            .map((link) => {
                const id = link.dataset.section;
                return id ? document.getElementById(id) : null;
            })
            .filter((section): section is HTMLElement => section !== null);

        if (sections.length === 0) return;

        const observerOptions = {
            root: null,
            rootMargin: '-40% 0px -40% 0px',
            threshold: 0
        };

        const observerCallback = (entries: IntersectionObserverEntry[]) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const activeId = entry.target.id;

                    navLinks.forEach((link) => {
                        link.classList.toggle('active', link.dataset.section === activeId);
                    });
                }
            });
        };

        const observer = new IntersectionObserver(observerCallback, observerOptions);
        sections.forEach((section) => observer.observe(section));
    }

    setupScrollSpy();
</script>