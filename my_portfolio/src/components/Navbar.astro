---
// src/components/Navbar.astro
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
import myLogoLightMode from '../assets/logo light mode.png';

// Respect the site's base path (/portfolio)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Are we on the standalone /projects page?
const onProjectsPage = Astro.url.pathname.replace(/\/$/, '').endsWith('/projects');

// Section links point at the home page, so they work from any page.
// "Projects" goes to its own page.
const links = [
    { label: 'About',         href: `${base}/#about`,         section: 'about' },
    { label: 'Experience',    href: `${base}/#experience`,    section: 'experience' },
    { label: 'Education',     href: `${base}/#education`,     section: 'education' },
    { label: 'Projects',      href: `${base}/projects`,       section: 'projects' },
    { label: 'Contributions', href: `${base}/#contributions`, section: 'contributions' },
    { label: 'Contact',       href: `${base}/#contact`,       section: 'contact' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#050507]/80 backdrop-blur-md border-b border-zinc-800/50 transition-all duration-200">
    <!--
        Mobile / tablet (< lg): row 1 = logo (left) + theme toggle (right), row 2 = scrolling nav.
        Desktop (lg+): one row = logo (left) ... nav | toggle (right).
        Source order is logo, nav, divider, toggle; `order-*` rearranges it per breakpoint.
    -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 lg:py-4 flex flex-wrap lg:flex-nowrap items-center justify-between gap-x-4 gap-y-3 lg:gap-x-6">

        <!-- Logo -->
        <a href={`${base}/`} class="order-1 hover:opacity-80 transition-opacity flex items-center gap-3 group">
            <!-- Both logos are rendered; CSS shows the right one for the current theme (no flash on load) -->
            <Image
                    src={myLogo}
                    alt="Binuk Pinsara Logo"
                    class="navbar-logo-dark w-8 h-8 sm:w-10 sm:h-10 object-contain"
            />
            <Image
                    src={myLogoLightMode}
                    alt=""
                    aria-hidden="true"
                    loading="eager"
                    class="navbar-logo-light w-8 h-8 sm:w-10 sm:h-10 object-contain"
            />
            <span class="text-white text-base sm:text-lg font-semibold tracking-tight">
                BinukPinsara
            </span>
        </a>

        <!-- Nav links -->
        <nav
                data-nav
                aria-label="Main"
                class="nav-scroll order-3 lg:order-2 relative flex items-center justify-start sm:justify-center lg:justify-end lg:ml-auto gap-5 sm:gap-6 lg:gap-8 text-xs sm:text-sm font-medium text-zinc-400 overflow-x-auto no-scrollbar py-1 -mx-4 px-4 w-[calc(100%+2rem)] sm:mx-0 sm:px-0 sm:w-full lg:w-auto"
        >
            {links.map((link) => (
                    <a
                            href={link.href}
                            data-section={link.section}
                            class:list={[
                                "nav-link relative shrink-0 py-1 hover:text-white transition-colors duration-150",
                                { active: onProjectsPage && link.section === 'projects' }
                            ]}
                            aria-current={onProjectsPage && link.section === 'projects' ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
            ))}
        </nav>

        <!-- Divider (desktop only) -->
        <span class="hidden lg:block order-3 h-6 w-px bg-zinc-700/60" aria-hidden="true"></span>

        <!-- Theme toggle -->
        <button
                type="button"
                data-theme-toggle
                aria-label="Switch to light mode"
                aria-pressed="false"
                title="Switch to light mode"
                class="theme-toggle order-2 lg:order-4 group/toggle relative inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-zinc-700/70 bg-zinc-900/60 text-zinc-300 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-cyan-400/50 hover:bg-zinc-800/80 hover:text-cyan-300 hover:shadow-[0_4px_18px_rgba(34,211,238,0.12)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
            <svg data-theme-icon="sun" class="h-[18px] w-[18px] transition-transform duration-300 group-hover/toggle:rotate-45" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
            <svg data-theme-icon="moon" class="hidden h-[18px] w-[18px] transition-transform duration-300 group-hover/toggle:-rotate-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
            </svg>
        </button>

    </div>
</header>

<style is:global>
    /* Logo swap: dark logo by default, light-mode logo when <html data-theme="light"> */
    .navbar-logo-light {
        display: none;
    }
    [data-theme="light"] .navbar-logo-dark {
        display: none;
    }
    [data-theme="light"] .navbar-logo-light {
        display: block;
    }
</style>

<style>
    /* Hide scrollbar utility for the mobile navigation bar */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Soft fade at both edges of the scrolling nav on small screens,
       so it's clear there are more links to swipe to */
    @media (max-width: 639px) {
        .nav-scroll {
            -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16px, #000 calc(100% - 16px), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 16px, #000 calc(100% - 16px), transparent 100%);
        }
    }

    /* Smooth underline animation */
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: #06b6d4; /* Matches Tailwind cyan-500 */
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    /* Show underline on hover */
    .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* Active state classes (set on the server for /projects, by JS on the home page) */
    .nav-link.active {
        color: white;
    }

    .nav-link.active::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .theme-toggle svg {
        grid-area: 1 / 1;
    }
</style>

<script>
    const nav = document.querySelector<HTMLElement>('[data-nav]');

    // Keep the active link visible when the nav scrolls sideways (mobile)
    function centerLink(link: HTMLElement) {
        if (!nav || nav.scrollWidth <= nav.clientWidth) return;
        const left = link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2;
        nav.scrollTo({ left, behavior: 'smooth' });
    }

    function setupScrollSpy() {
        const navLinks = document.querySelectorAll<HTMLElement>('.nav-link');

        // Only sections that exist on the current page are watched.
        // On /projects none of them exist, so this exits and the server-set active link stays.
        const sections = Array.from(navLinks)
            .map((link) => {
                const id = link.dataset.section;
                return id ? document.getElementById(id) : null;
            })
            .filter((section): section is HTMLElement => section !== null);

        if (sections.length === 0) return;

        const observerOptions = {
            root: null,
            rootMargin: '-40% 0px -40% 0px',
            threshold: 0
        };

        const observerCallback = (entries: IntersectionObserverEntry[]) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const activeId = entry.target.id;

                    navLinks.forEach((link) => {
                        const isActive = link.dataset.section === activeId;
                        const wasActive = link.classList.contains('active');
                        link.classList.toggle('active', isActive);
                        if (isActive && !wasActive) centerLink(link);
                    });
                }
            });
        };

        const observer = new IntersectionObserver(observerCallback, observerOptions);
        sections.forEach((section) => observer.observe(section));
    }

    const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const sunIcon = themeToggle?.querySelector<SVGElement>('[data-theme-icon="sun"]');
    const moonIcon = themeToggle?.querySelector<SVGElement>('[data-theme-icon="moon"]');

    function updateThemeToggle(theme: 'dark' | 'light') {
        const isDark = theme === 'dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
        themeToggle?.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} mode`);
        themeToggle?.setAttribute('aria-pressed', String(!isDark));
        sunIcon?.classList.toggle('hidden', !isDark);
        moonIcon?.classList.toggle('hidden', isDark);
    }

    const initialTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    updateThemeToggle(initialTheme);

    themeToggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('portfolio-theme', theme);
        updateThemeToggle(theme);
    });

    setupScrollSpy();

    // On /projects the active link is set by the server: bring it into view
    const serverActive = nav?.querySelector<HTMLElement>('.nav-link.active');
    if (serverActive) centerLink(serverActive);
</script>