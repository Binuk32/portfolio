---
// src/components/Navbar.astro
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
---
<!--
  1. Changed to 'sticky top-0' to keep it fixed at the top on scroll.
  2. Added 'backdrop-blur-md' and a subtle background tint ('bg-[#050507]/70') to blur the content underneath.
  3. Added a clean, translucent bottom border ('border-b border-zinc-800/50').
-->
<header class="sticky top-0 z-50 w-full bg-[#050507]/70 backdrop-blur-md border-b border-zinc-800/50 transition-all duration-200">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center gap-8">

        <!-- Logo Area (Stays Left) -->
        <a href="#" class="hover:opacity-80 transition-opacity flex items-center gap-4 group">
            <!-- Increased logo size from w-8 h-8 to w-10 h-10 -->
            <Image
                    src={myLogo}
                    alt="Binuk Pinsara Logo"
                    class="w-10 h-10 object-contain"
            />
            <!-- Increased font size to text-lg and adjusted weight -->
            <span class="text-white text-lg font-semibold tracking-tight hidden sm:inline-block">
                BinukPinsara
            </span>
        </a>

        <!-- Navigation Links (Aligned Right) -->
        <div class="flex items-center gap-6 md:gap-8 text-sm font-medium text-zinc-400">
            <a href="#about" class="hover:text-white transition-colors duration-150">About</a>
            <a href="#experience" class="hover:text-white transition-colors duration-150">Experience</a>
            <a href="#education" class="hover:text-white transition-colors duration-150">Education</a>
            <a href="#projects" class="hover:text-white transition-colors duration-150">Projects</a>
            <a href="#contact" class="hover:text-white transition-colors duration-150">Contact</a>
        </div>

    </div>
</header>