<div id="tsparticles-grid" class="absolute inset-0 z-0 pointer-events-none opacity-100">
    <!-- Reduced blur amount: backdrop-blur-[2px] is extremely expensive on mobile GPUs -->
    <div class="absolute inset-0 bg-[#050507]/20"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2/tsparticles.slim.bundle.min.js" is:inline></script>

<script is:inline>
    (async () => {
        // Precise mobile check
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;

        await tsParticles.load("tsparticles-grid", {
            background: { color: { value: "#050507" } },
            // Cap FPS to 30 or 60 max on mobile to prevent main-thread UI thread blocking
            fpsLimit: isMobile ? 30 : 60,
            interactivity: {
                events: {
                    // Disable click & hover physics engines completely on mobile to prevent input lag
                    onClick: { enable: !isMobile, mode: "repulse" },
                    onHover: { enable: !isMobile, mode: ["bubble", "grab"] },
                    resize: true,
                },
                modes: {
                    bubble: {
                        distance: 180,
                        size: 8,
                        duration: 1.5,
                        color: ["#22d3ee", "#3b82f6", "#ffffff"],
                        opacity: 1
                    },
                    grab: {
                        distance: 200,
                        links: { opacity: 0.35, color: "#22d3ee" }
                    },
                    repulse: { distance: 150 },
                },
            },
            particles: {
                color: {
                    value: ["#ffffff", "#3b82f6", "#22d3ee"]
                },
                links: {
                    color: { value: "#3b82f6" },
                    distance: isMobile ? 100 : 160,
                    enable: true,
                    opacity: isMobile ? 0.12 : 0.2,
                    width: 0.8,
                },
                move: {
                    direction: "none",
                    enable: true,
                    outModes: { default: "out" },
                    speed: isMobile ? 0.4 : { min: 0.5, max: 1.5 },
                    straight: false,
                },
                number: {
                    // Disabling density on mobile ensures strict particle cap without scaling math
                    density: { enable: !isMobile, area: 900 },
                    value: isMobile ? 18 : 80 // 18-20 particles is the sweet spot for mobile 60fps scrolling
                },
                opacity: {
                    value: { min: 0.3, max: 0.8 },
                },
                shape: { type: "circle" },
                size: {
                    value: { min: 1, max: 2.5 },
                },
            },
            detectRetina: true,
        });
    })();
</script>