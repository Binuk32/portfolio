<!-- src/components/TechParticles.astro -->
<div id="tsparticles-grid" class="absolute inset-0 z-0 pointer-events-none opacity-100">
    <!-- Overlay for added background texture -->
    <div class="absolute inset-0 bg-[#050507]/20 backdrop-blur-[2px]"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2/tsparticles.slim.bundle.min.js" is:inline></script>

<script is:inline>
    (async () => {
        await tsParticles.load("tsparticles-grid", {
            background: { color: { value: "#050507" } }, // Dark, rich canvas
            fpsLimit: 120,
            interactivity: {
                events: {
                    onClick: { enable: true, mode: "repulse" }, // Dynamic repulse effect on click
                    onHover: {
                        enable: true,
                        mode: ["bubble", "grab"] // Dual hover mode for bubbles and connecting lines
                    },
                    resize: true,
                },
                modes: {
                    bubble: {
                        distance: 180, // Expands interaction range slightly
                        size: 8, // Bubbles grow larger
                        duration: 1.5,
                        // Bubbles now gleam with a brilliant cyan/blue gradient
                        color: ["#22d3ee", "#3b82f6", "#ffffff"],
                        opacity: 1 // Full visibility on hover
                    },
                    grab: {
                        distance: 200,
                        links: {
                            opacity: 0.35, // Lines connected to mouse become much brighter
                            color: "#22d3ee" // Highlighted lines pulse cyan
                        }
                    },
                    repulse: { distance: 150 },
                },
            },
            particles: {
                color: {
                    // Main particles oscillate between these electric colors
                    value: ["#ffffff", "#3b82f6", "#22d3ee"]
                },
                links: {
                    // Links glow with a consistent electric blue
                    color: { value: "#3b82f6" },
                    distance: 160, // Sparser grid is more elegant
                    enable: true,
                    opacity: 0.2, // Higher default link visibility
                    width: 0.9,
                },
                move: {
                    direction: "none",
                    enable: true,
                    outModes: { default: "out" }, // Smooth transitions across screen edges
                    speed: { min: 0.5, max: 1.5 }, // Variable speeds create natural movement
                    straight: false,
                },
                number: {
                    density: { enable: true, area: 900 },
                    value: 85 // Optimized particle count for atmospheric flow
                },
                opacity: {
                    value: { min: 0.3, max: 0.8 }, // Variable opacity creates depth
                },
                shape: { type: "circle" },
                size: {
                    value: { min: 1, max: 3.5 }, // Slightly larger maximum particle size
                },
            },
            detectRetina: true,
        });
    })();
</script>