<div id="tsparticles-grid" class="absolute inset-0 z-0 pointer-events-none opacity-100">
    <div class="absolute inset-0 bg-[#050507]/20 backdrop-blur-[2px]"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2/tsparticles.slim.bundle.min.js" is:inline></script>

<script is:inline>
    (async () => {
        // Quick check to see if the user is on a mobile device
        const isMobile = window.innerWidth < 768;

        await tsParticles.load("tsparticles-grid", {
            background: { color: { value: "#050507" } },
            // Lower FPS limit on mobile dramatically reduces CPU usage
            fpsLimit: isMobile ? 60 : 120,
            interactivity: {
                events: {
                    onClick: { enable: true, mode: "repulse" },
                    onHover: {
                        enable: !isMobile, // Disable hover interactions on mobile (since there is no mouse hover)
                        mode: ["bubble", "grab"]
                    },
                    resize: true,
                },
                modes: {
                    bubble: {
                        distance: 180,
                        size: 8,
                        duration: 1.5,
                        color: ["#22d3ee", "#3b82f6", "#ffffff"],
                        opacity: 1
                    },
                    grab: {
                        distance: 200,
                        links: {
                            opacity: 0.35,
                            color: "#22d3ee"
                        }
                    },
                    repulse: { distance: 150 },
                },
            },
            particles: {
                color: {
                    value: ["#ffffff", "#3b82f6", "#22d3ee"]
                },
                links: {
                    color: { value: "#3b82f6" },
                    distance: isMobile ? 130 : 160, // Tighter distance on mobile so links aren't stretched
                    enable: true,
                    opacity: isMobile ? 0.15 : 0.2, // Slightly fainter links to save rendering power
                    width: 0.9,
                },
                move: {
                    direction: "none",
                    enable: true,
                    outModes: { default: "out" },
                    // Slower movement on mobile looks cleaner and performs better
                    speed: isMobile ? { min: 0.3, max: 0.8 } : { min: 0.5, max: 1.5 },
                    straight: false,
                },
                number: {
                    density: { enable: true, area: 900 },
                    // Drop the particle count significantly on mobile
                    value: isMobile ? 35 : 85
                },
                opacity: {
                    value: { min: 0.3, max: 0.8 },
                },
                shape: { type: "circle" },
                size: {
                    value: { min: 1, max: 3.5 },
                },
            },
            // Disable retina detection on mobile to prevent rendering 4x the pixels
            detectRetina: !isMobile,
        });
    })();
</script>