
---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';
import TechParticles from '../components/TechParticles.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import scanmarkImg from '../assets/project-screenshots/scanmark1.jpg';
import hirenearImg from '../assets/project-screenshots/hirenear1.jpg';
import boardmateImg from '../assets/project-screenshots/BoardMate.jpg';
import vsenseImg from '../assets/project-screenshots/V-Sense.jpg';
import kulraImg from '../assets/project-screenshots/Kulra.jpg';
import viteloomImg from '../assets/project-screenshots/viteloom.jpg';

import binukAvatar from '../assets/profile_photo.jpg';
import mithilaAvatar from '../assets/project-screenshots/BoardMate partner.png';
import poornaAvatar from '../assets/project-screenshots/poorna.png';

// Respect the site's base path
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
    {
        id: 'vsense',
        title: 'V-Sense',
        subtitle: 'Agentic AI-powered vehicle history & fraud detection system',
        description:
            "An integrated web and mobile platform designed to bring transparency to Sri Lanka's used-vehicle market. V-Sense combines verified vehicle records, specialized AI agents, fraud detection, and human oversight to deliver reliable vehicle history and valuation reports.",
        features: [
            'Verified vehicle service records and odometer tracking',
            'Centralized ownership, registration, insurance, and accident history',
            'Four specialized AI agents for history analysis, fraud detection, and valuation',
            'Human-in-the-loop administrator review for suspicious reports',
            'QR-based digital vehicle certification and public verification',
            'Verified garage discovery, bookings, and real-time notifications'
        ],
        techStack: [
            'React 19',
            'Tailwind CSS',
            'Flutter',
            'ASP.NET Core 8',
            'C#',
            'PostgreSQL',
            'Supabase',
            'Python',
            'FastAPI',
            'LangGraph',
            'LangChain',
            'Google Gemini',
            'PayHere',
            'Cloudinary'
        ],
        image: vsenseImg,
        teamSize: 4,
        github: 'https://github.com/SadeshRaj/V-Sense'
    },
    {
        id: 'scanmark',
        title: 'ScanMark',
        subtitle: 'QR-based attendance management system',
        description:
            'A full-stack platform for university attendance, live session monitoring and real-time student notifications. Lecturers and admins use a web dashboard; undergraduates use a cross-platform mobile app.',
        features: [
            'Role-based access control',
            'Dynamic QR code generation and verification',
            'Expo push notifications',
            'JWT auth with OTP account recovery'
        ],
        techStack: [
            'Spring Boot',
            'React Native',
            'React.js',
            'MongoDB',
            'Tailwind CSS',
            'Expo'
        ],
        image: scanmarkImg,
        teamSize: 6,
        github: 'https://github.com/Binuk32/qr-based-attendance-management-system'
    },
    {
        id: 'boardmate',
        title: 'BoardMate',
        subtitle: 'Location-aware accommodation finder',
        description:
            'A mobile marketplace that connects students with boarding owners. Owners publish properties with occupancy and pricing details; students find places through map-based search and chat with owners directly.',
        features: [
            'SMS OTP verification via Text.lk',
            'Geospatial search by proximity',
            'Real-time chat with Socket.io',
            'Cloudinary image storage'
        ],
        techStack: [
            'React Native',
            'Expo',
            'Node.js',
            'Express',
            'MongoDB',
            'Socket.io',
            'Tailwind CSS'
        ],
        image: boardmateImg,
        teamSize: 2,
        contributors: [
            {
                name: 'Binuk',
                url: 'https://github.com/Binuk32',
                avatar: binukAvatar
            },
            {
                name: 'Mithila',
                url: 'https://github.com/Mithila-Minidul',
                avatar: mithilaAvatar
            }
        ]
    },
    {
        id: 'hirenear',
        title: 'HireNear',
        subtitle: 'Location-aware freelance marketplace',
        description:
            'A mobile app that matches people who need a service with nearby freelancers, covering the whole hiring flow from OTP sign-up and chat to live admin oversight.',
        features: [
            'SMS OTP-verified registration',
            'Stateless JWT auth with admin bans',
            'Direct chat and auto-reply admin channel',
            'Cloudinary uploads and Expo Location'
        ],
        techStack: [
            'React Native',
            'Expo',
            'Node.js',
            'Express',
            'MongoDB',
            'Socket.io',
            'React.js',
            'Tailwind CSS'
        ],
        image: hirenearImg,
        teamSize: 6,
        github: 'https://github.com/SadeshRaj/HireNear-Mobile-App'
    },
    {
        id: 'kulra',
        title: 'Kulra',
        subtitle: 'Full-stack restaurant website for a Sri Lankan village-style dining experience',
        description:
            'A real-world restaurant website developed for a client in Nawalapitiya, Sri Lanka. The platform combines a customer-facing restaurant experience with a protected administration dashboard for managing reservations, menu content, categories, and administrator accounts.',
        projectType: 'Client Project',
        features: [
            'Traditional restaurant homepage and brand story',
            'Sri Lankan and international menu browsing',
            'Virtual restaurant tour',
            'Table reservation requests',
            'Protected admin dashboard',
            'JWT authentication and bcrypt password security',
            'Cloudinary image uploads',
            'Reservation and menu management'
        ],
        techStack: [
            'React',
            'TypeScript',
            'Vite',
            'Tailwind CSS',
            'Hono',
            'Cloudflare Workers',
            'MongoDB',
            'JWT',
            'Cloudinary'
        ],
        image: kulraImg,
        teamSize: 1,
        liveUrl: 'https://kulra.pages.dev/'
    },
    {
        id: 'viteloom',
        title: 'ViteLoom',
        subtitle: 'Full-stack digital wedding platform',
        description:
            'A full-stack wedding platform that helps couples create and publish digital wedding experiences. From personalized invitations and seating plans to live galleries, RSVP collection, payments, and custom wedding requests, ViteLoom brings essential wedding planning features together in one platform.',
        features: [
            'Customizable digital invitations with multiple templates, event details, stories, music, and countdowns',
            'Guest RSVP collection and attendance management',
            'Seating plans with Excel/CSV imports, manual guest entry, and public guest pages',
            'Wedding agendas with templates and drag-and-reorder support',
            'Live photo and video galleries with compression, downloads, and ZIP export',
            'Custom profile link pages with QR codes',
            'PayHere card payments and bank-slip submissions',
            'Custom wedding design and asset requests',
            'User dashboard and comprehensive admin panel',
            'Google OAuth, OTP verification, and JWT authentication'
        ],
        techStack: [
            'React 19',
            'TypeScript',
            'Vite',
            'Tailwind CSS',
            'React Router',
            'Hono',
            'Cloudflare Workers',
            'MongoDB',
            'Cloudinary',
            'Cloudflare R2',
            'PayHere',
            'Brevo',
            'JWT',
            'Google OAuth'
        ],
        image: viteloomImg,
        teamSize: 2,
        liveUrl: 'https://viteloom.com/',
        contributors: [
            {
                name: 'Binuk',
                url: 'https://github.com/Binuk32',
                avatar: binukAvatar
            },
            {
                name: 'Poorna',
                url: 'https://github.com/SadeshRaj',
                avatar: poornaAvatar
            }
        ]
    }
];
---

<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
            name="description"
            content="Projects by Binuk Pinsara: V-Sense, ScanMark, BoardMate, HireNear, Kulra and ViteLoom."
    />
    <title>Projects | Binuk Pinsara</title>

    <script is:inline>
        document.documentElement.dataset.theme =
            localStorage.getItem('portfolio-theme') === 'light' ? 'light' : 'dark';
    </script>
</head>

<body class="bg-[#050507] text-white font-sans min-h-screen relative flex flex-col overflow-x-hidden antialiased">

<TechParticles />
<Navbar />

<main class="relative z-10 flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 py-12 md:py-20">

    <div class="max-w-2xl mb-12 md:mb-16">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white">
            Projects
        </h1>
        <p class="mt-4 text-zinc-400 text-base sm:text-lg leading-relaxed">
            A collection of full-stack web and mobile applications built through academic,
            personal, and client projects, exploring modern software engineering,
            cloud technologies, and AI-powered solutions.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">

        {projects.map((project) => (
                <article
                        class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 backdrop-blur-sm transition-colors duration-300 hover:border-cyan-500/40"
                        aria-labelledby={`project-${project.id}`}
                >

                    <!-- Screenshot -->
                    <div class="relative aspect-[16/10] overflow-hidden bg-zinc-950 border-b border-zinc-800">
                        <Image
                                src={project.image}
                                alt={`${project.title} screenshots`}
                                widths={[400, 700, 1000]}
                                sizes="(min-width: 1280px) 400px, (min-width: 768px) 50vw, 100vw"
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        />
                    </div>

                    <!-- Content -->
                    <div class="flex flex-col flex-1 p-5 sm:p-6 gap-4">

                        <div>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                <h2
                                        id={`project-${project.id}`}
                                        class="text-2xl font-bold tracking-tight text-white"
                                >
                                    {project.title}
                                </h2>

                                <span class="text-xs text-cyan-300 bg-cyan-500/10 border border-cyan-500/20 rounded-full px-2.5 py-0.5">
                                    {project.projectType || `Team of ${project.teamSize}`}
                                </span>
                            </div>

                            <p class="mt-1 text-sm text-cyan-400">
                                {project.subtitle}
                            </p>
                        </div>

                        <p class="text-sm text-zinc-300 leading-relaxed">
                            {project.description}
                        </p>

                        <ul class="space-y-1.5">
                            {project.features.map((feature) => (
                                    <li class="flex items-start gap-2.5 text-sm text-zinc-400">
                                        <svg
                                                class="w-4 h-4 mt-0.5 shrink-0 text-cyan-400"
                                                viewBox="0 0 20 20"
                                                fill="currentColor"
                                                aria-hidden="true"
                                        >
                                            <path
                                                    fill-rule="evenodd"
                                                    d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                                                    clip-rule="evenodd"
                                            />
                                        </svg>
                                        <span>{feature}</span>
                                    </li>
                            ))}
                        </ul>

                        <div class="flex flex-wrap gap-1.5">
                            {project.techStack.map((tech) => (
                                    <span class="text-xs px-2.5 py-1 rounded-md bg-zinc-950/70 border border-zinc-800 text-zinc-300">
                                    {tech}
                                </span>
                            ))}
                        </div>

                        <!-- Footer: Contributors and project links -->
                        <div class="mt-auto pt-4 border-t border-zinc-800 flex flex-wrap items-center justify-between gap-4">

                            <!-- Clickable contributor avatars -->
                            <div class="flex items-center gap-2">
                                {project.contributors && project.contributors.map((contributor) => (
                                        <a
                                                href={contributor.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                title={`Visit ${contributor.name}'s GitHub profile`}
                                                aria-label={`Visit ${contributor.name}'s GitHub profile`}
                                                class="block rounded-full ring-2 ring-zinc-800 hover:ring-cyan-400 transition-all duration-200 hover:scale-110"
                                        >
                                            <Image
                                                    src={contributor.avatar}
                                                    alt={`${contributor.name}'s profile`}
                                                    width={36}
                                                    height={36}
                                                    class="w-9 h-9 rounded-full object-cover"
                                            />
                                        </a>
                                ))}
                            </div>

                            <!-- Live site and GitHub buttons -->
                            <div class="flex flex-wrap items-center gap-2 ml-auto">

                                {project.liveUrl && (
                                        <a
                                                href={project.liveUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-semibold text-zinc-950 bg-cyan-400 hover:bg-cyan-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300 transition-colors"
                                        >
                                            <svg
                                                    class="w-4 h-4"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    viewBox="0 0 24 24"
                                                    aria-hidden="true"
                                            >
                                                <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="M14 3h7v7m-1-6L10 14"
                                                />
                                                <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"
                                                />
                                            </svg>
                                            Live Site
                                        </a>
                                )}

                                {project.github && (
                                        <a
                                                href={project.github}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-semibold text-zinc-950 bg-cyan-400 hover:bg-cyan-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300 transition-colors"
                                        >
                                            <svg
                                                    class="w-4 h-4 fill-current"
                                                    viewBox="0 0 24 24"
                                                    aria-hidden="true"
                                            >
                                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                            </svg>
                                            View Code
                                        </a>
                                )}

                            </div>
                        </div>

                    </div>
                </article>
        ))}

    </div>
</main>

<Footer />

</body>
</html>
